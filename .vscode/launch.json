{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "nRF53-DK Debug",
            "cwd": "${workspaceFolder}",
            "executable": "/Users/assetmalik/dev/nrf52/tock/target/thumbv8m.main-none-eabi/debug/nrf5340dk.elf",
            "request": "launch",
            "type": "cortex-debug",
            "servertype": "jlink",
            "device": "nRF5340_xxAA",
            "interface": "swd",
            "runToEntryPoint": "main",
            "svdFile": "${env:HOME}/.vscode/nrf5340.svd",
            // "preLaunchTask": "Build Tock",
            "postLaunchCommands": [
                "monitor speed auto",
                "monitor reset halt",
                "b initialize_ram_jump_to_main",
                "continue"
            ]
        }
    ]
}
